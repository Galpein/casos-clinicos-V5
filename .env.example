# ============================================================================
#  AtlasCases v5 — variables de entorno
#  Copia este archivo a .env.local para desarrollo, o pega el contenido en el
#  apartado Environment de Dokploy para producción.
#  Ninguna variable lleva el prefijo NEXT_PUBLIC_ a propósito: ese prefijo
#  mete el valor dentro del JavaScript que descarga el navegador.
# ============================================================================

# ── 1. Tiempo de ejecución ──────────────────────────────────────────────────
# YA VIENEN FIJADAS EN EL Dockerfile. Sólo hace falta declararlas si ejecutas
# la aplicación fuera del contenedor o quieres cambiar el puerto.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# ── 2. Base de datos ────────────────────────────────────────────────────────
# La cadena la da Dokploy al crear el servicio de Postgres. Usa el host interno
# (el nombre del servicio en la red de Docker), no el público.
DATABASE_URL=postgres://atlascases:CONTRASEÑA@atlascases-db:5432/atlascases
# Número máximo de conexiones simultáneas del pool. 10 sobra para el MVP.
DATABASE_POOL_MAX=10

# ── 3. Asistente de IA (Google Gemini) ──────────────────────────────────────
# La clave se obtiene en Google AI Studio.
GEMINI_API_KEY=
# El modelo se declara aparte para poder cambiarlo sin volver a desplegar.
GEMINI_MODEL=gemini-2.5-flash
# Si se deja en 0, el asistente usa el motor propio (diccionario) aunque haya
# clave. Sirve para desactivar la IA sin borrar credenciales.
AI_ENABLED=1

# ── 4. Sesiones y cuentas ───────────────────────────────────────────────────
# Firma las sesiones. Genérala con: openssl rand -base64 32
AUTH_SECRET=
# URL pública de la aplicación (para enlaces absolutos y callbacks).
APP_URL=https://tu-dominio.com

# ── 5. Operación ────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# Ejecutar las migraciones pendientes al arrancar el contenedor.
RUN_MIGRATIONS=1
